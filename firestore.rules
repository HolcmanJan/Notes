rules_version = '2';

// Každý přihlášený uživatel smí číst a zapisovat jen svá vlastní data pod users/{svoje uid}.
// Všechno ostatní je zakázané. Pravidla se nasazují v konzoli Firebase (Firestore → Rules)
// nebo příkazem `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
